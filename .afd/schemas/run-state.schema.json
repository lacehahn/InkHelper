{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inkhelper.local/afd/schemas/run-state.schema.json",
  "title": "AFD Autonomous Run State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "repository", "starting_commit", "current_checkpoint_commit", "current_task", "task_queue", "completed_tasks", "blocked_tasks", "failed_tasks", "retry_counts", "validation_history", "review_history", "generated_artifacts", "run_status", "stop_reason", "start_time", "last_update_time", "completion_time"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{0,62}$" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_path", "identity"],
      "properties": {
        "root_path": { "const": "." },
        "identity": { "type": "string", "minLength": 1 }
      }
    },
    "starting_commit": { "$ref": "#/$defs/commitOrNull" },
    "current_checkpoint_commit": { "$ref": "#/$defs/commitOrNull" },
    "current_task": { "anyOf": [{ "$ref": "#/$defs/taskId" }, { "type": "null" }] },
    "task_queue": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/taskId" } },
    "completed_tasks": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/taskId" } },
    "blocked_tasks": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/taskId" } },
    "failed_tasks": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/taskId" } },
    "retry_counts": {
      "type": "object",
      "patternProperties": { "^task-[a-z0-9][a-z0-9-]{0,62}$": { "type": "integer", "minimum": 0, "maximum": 2 } },
      "additionalProperties": false
    },
    "validation_history": { "type": "array", "items": { "$ref": "#/$defs/historyRecord" } },
    "review_history": { "type": "array", "items": { "$ref": "#/$defs/historyRecord" } },
    "generated_artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifactReference" } },
    "run_status": { "enum": ["planned", "running", "paused", "blocked", "failed", "completed", "cancelled"] },
    "stop_reason": { "enum": ["none", "task_failure", "policy_stop", "specification_conflict", "environment_failure", "successful_completion", "user_cancelled"] },
    "start_time": { "type": "string", "format": "date-time" },
    "last_update_time": { "type": "string", "format": "date-time" },
    "completion_time": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
    "extensions": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "run_status": { "const": "completed" } }, "required": ["run_status"] },
      "then": { "properties": { "stop_reason": { "const": "successful_completion" }, "completion_time": { "type": "string", "format": "date-time" } } }
    },
    {
      "if": { "properties": { "run_status": { "enum": ["blocked", "failed", "cancelled"] } }, "required": ["run_status"] },
      "then": { "properties": { "stop_reason": { "not": { "const": "none" } } } }
    }
  ],
  "$defs": {
    "taskId": { "type": "string", "pattern": "^task-[a-z0-9][a-z0-9-]{0,62}$" },
    "commitOrNull": { "anyOf": [{ "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" }, { "type": "null" }] },
    "repositoryPath": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\).+" },
    "historyRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "artifact_path", "status", "recorded_at"],
      "properties": {
        "task_id": { "$ref": "#/$defs/taskId" },
        "artifact_path": { "$ref": "#/$defs/repositoryPath" },
        "status": { "enum": ["passed", "failed", "not_run", "blocked", "partially_verified", "approved", "changes_required"] },
        "recorded_at": { "type": "string", "format": "date-time" }
      }
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": { "enum": ["task_record", "validation_evidence", "review_record", "completion_report", "log", "diff", "checkpoint", "package_report"] },
        "path": { "$ref": "#/$defs/repositoryPath" }
      }
    }
  }
}
